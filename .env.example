# Общие настройки
DEBUG=True
SECRET_KEY=секретный_ключ

# База данных (основная dev)
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=django_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
OUTER_POSTGRES_PORT=15432

# Тестовая база данных
TEST_DB_NAME=test_db
TEST_DB_USER=test_user
TEST_DB_PASSWORD=test_password
OUTER_TEST_DB_PORT=15433

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
OUTER_REDIS_PORT=16379

NGINX_PORT=81
DOZZLE_PORT=8001

PROJECT_NAME=tgbot

# TG_WEBHOOK_HOST='https://veqfr-146-19-207-68.run.pinggy-free.link'
# TG_DEBUG=True

# ============================================
# 🐕 HOUND - настройки браузера для обхода ограничений
# ============================================
# Порт, на котором будет доступен Hound (локально)
HOUND_PORT=8080

# Режим работы (headless = без графического интерфейса, экономит память)
HOUND_HEADLESS=true

# Максимальное количество одновременных сессий
HOUND_MAX_CONCURRENT=5

# Таймаут загрузки страницы в миллисекундах (30 секунд)
HOUND_TIMEOUT=30000

# Путь для сохранения кэша (опционально, для ускорения повторных запросов)
# HOUND_CACHE_DIR=/app/cache

# Включить/выключить smart_fetch для обхода Cloudflare (по умолчанию true)
# HOUND_SMART_FETCH=true

# Путь к браузеру Patchright (если нужен для обхода капч)
# HOUND_PATCHRIGHT_PATH=/usr/bin/patchright

# Логирование (debug, info, warn, error)
# HOUND_LOG_LEVEL=info